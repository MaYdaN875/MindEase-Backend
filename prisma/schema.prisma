datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                  String                      @id @default(uuid())
  email               String                      @unique
  passwordHash        String
  name                String
  phone               String?
  status              UserStatus                  @default(ACTIVE)
  resetPasswordToken  String?
  resetPasswordExp    DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  userRoles           UserRole[]
  psychologistProfile PsychologistProfile?
  auditLogs           AuditLog[]
  consents            UserConsent[]
  notifications       Notification[]
  verificationReviews VerificationReview[]        @relation("RevisorReviews")
  changedStatusLogs   VerificationStatusHistory[] @relation("StatusChanges")
  patientAppointments Appointment[]               @relation("PatientAppointments")
  privateMessages     PrivateMessage[]
  contactConversations Conversation[]
  payments            Payment[]                   @relation("PatientPayments")
  channelFollows      ChannelFollow[]
  communityPosts      CommunityPost[]
  postLikes           PostLike[]
  postComments        PostComment[]
  moderatedPosts      CommunityPost[]             @relation("PostModerator")
  reportedItems       CommunityReport[]           @relation("UserReports")
  reviewedReports     CommunityReport[]           @relation("ReportReviewer")
  createdTickets      SupportTicket[]             @relation("UserTickets")
  assignedTickets     SupportTicket[]             @relation("AssignedTickets")
  ticketMessages      TicketMessage[]
  filedUserReports    UserReport[]                @relation("UserReporter")
  receivedUserReports UserReport[]                @relation("ReportedUser")
  investigatedReports UserReport[]                @relation("ReportInvestigator")
  aiOrientationSessions AIOrientationSession[]    @relation("UserAIOrientations")
}


model Role {
  id        String     @id @default(uuid())
  name      String     @unique // e.g. "USER", "PSYCHOLOGIST_APPLICANT", "PSYCHOLOGIST_VERIFIED", "MODERATOR", "REVISOR", "SUPPORT", "ADMIN", "SUPERADMIN"
  userRoles UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum PsychologistStatus {
  REGISTRO_INCOMPLETO
  PENDIENTE_REVISION
  EN_REVISION
  REQUIERE_CAMBIOS
  VERIFICADO
  RECHAZADO
  SUSPENDIDO
  INACTIVO
}

model PsychologistProfile {
  id                   String                      @id @default(uuid())
  userId               String                      @unique
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl             String?
  description          String?
  academicBackground   String?
  experience           String?
  consultationPrice    Float?
  availability         Json? // Stores calendar availability structure (legacy/extra metadata)
  languages            String?
  location             String?
  licenseNumber        String?
  status               PsychologistStatus          @default(REGISTRO_INCOMPLETO)
  autoConfirmAppointments Boolean                  @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime            @updatedAt
  specialties          PsychologistSpecialty[]
  documents            ProfessionalDocument[]
  statusHistory        VerificationStatusHistory[]
  verificationRequests VerificationRequest[]
  availabilities       PsychologistAvailability[]
  appointments         Appointment[]
  payments             Payment[]                   @relation("PsychologistPayments")
  payoutRequests       PayoutRequest[]
  channels             CommunityChannel[]
  aiRecommendations    AIRecommendation[]
  contactConversations Conversation[]
}

model Specialty {
  id                String                  @id @default(uuid())
  name              String                  @unique
  psychologists     PsychologistSpecialty[]
  aiRecommendations AIRecommendation[]
}

model PsychologistSpecialty {
  psychologistId String
  specialtyId    String
  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  specialty      Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([psychologistId, specialtyId])
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfessionalDocument {
  id               String              @id @default(uuid())
  psychologistId   String
  psychologist     PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  documentType     String // e.g., "ID", "DEGREE", "LICENSE", "OTHER"
  storageKey       String
  originalFilename String
  mimeType         String
  fileSize         Int
  status           DocumentStatus      @default(PENDING)
  uploadedAt       DateTime            @default(now())
  expiresAt        DateTime?
}

model VerificationRequest {
  id             String               @id @default(uuid())
  psychologistId String
  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  revisorId      String?
  status         String               @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  reviews        VerificationReview[]
}

model VerificationReview {
  id        String              @id @default(uuid())
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  revisorId String
  revisor   User                @relation("RevisorReviews", fields: [revisorId], references: [id], onDelete: Cascade)
  decision  String // APPROVE, REQUEST_CHANGES, REJECT
  notes     String?
  createdAt DateTime            @default(now())
}

model VerificationStatusHistory {
  id             String              @id @default(uuid())
  psychologistId String
  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  fromStatus     PsychologistStatus
  toStatus       PsychologistStatus
  changedById    String
  changedBy      User                @relation("StatusChanges", fields: [changedById], references: [id], onDelete: Cascade)
  comment        String?
  changedAt      DateTime            @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String // e.g., "PRIVACY_POLICY", "PROFESSIONAL_TERMS"
  acceptedAt  DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        String   @default("SYSTEM") // APPOINTMENT_REQUEST, APPOINTMENT_CONFIRMED, APPOINTMENT_CANCELLED, CONSULTATION_STARTED, SYSTEM
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model PsychologistAvailability {
  id             String              @id @default(uuid())
  psychologistId String
  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  startTime      String              // e.g. "09:00" (HH:mm format)
  endTime        String              // e.g. "14:00" (HH:mm format)
  slotDuration   Int                 @default(50) // consultation duration in minutes
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([psychologistId, dayOfWeek])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id                 String              @id @default(uuid())
  psychologistId     String
  psychologist       PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation("PatientAppointments", fields: [userId], references: [id], onDelete: Cascade)
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus   @default(PENDING)
  price              Float
  currency           String              @default("MXN")
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  consultation       Consultation?
  privateMessages    PrivateMessage[]
  patientReview      PatientReview?
  payment            Payment?
  userReports        UserReport[]

  @@index([psychologistId, startAt])

  @@index([userId, startAt])
}

enum PatientReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model PatientReview {
  id            String @id @default(uuid())
  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  status        PatientReviewStatus @default(PENDING)
  createdAt     DateTime @default(now())
  moderatedAt   DateTime?
  moderatorId   String?
  moderationReason String?

  @@index([status, createdAt])
}

model PrivateMessage {
  id            String      @id @default(uuid())
  sequence      Int         @unique @default(autoincrement())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientId      String
  content       String
  createdAt     DateTime    @default(now())
  readAt        DateTime?

  @@unique([appointmentId, senderId, clientId])
  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, sequence])
  @@index([conversationId, readAt, senderId])
  @@index([appointmentId, sequence])
  @@index([appointmentId, readAt, senderId])
  @@index([senderId, createdAt])
}

// Contact conversations never become appointments or contain clinical records.
model Conversation {
  id String @id @default(uuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
  psychologistId String
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  patientBlocked Boolean @default(false)
  psychologistBlocked Boolean @default(false)
  createdAt DateTime @default(now())
  messages PrivateMessage[]
  @@unique([patientId, psychologistId])
  @@index([patientId, createdAt])
  @@index([psychologistId, createdAt])
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        ConsultationStatus @default(SCHEDULED)
  startedAt     DateTime?
  endedAt       DateTime?
  clinicalNotes String?
  meetingUrl    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum PaymentStatus {
  PENDING
  PROCESSING
  REFUND_PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  WALLET
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

model Payment {
  id             String            @id @default(uuid())
  appointmentId  String            @unique
  appointment    Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        User              @relation("PatientPayments", fields: [patientId], references: [id], onDelete: Cascade)
  psychologistId String
  psychologist   PsychologistProfile @relation("PsychologistPayments", fields: [psychologistId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("MXN")
  platformFee    Decimal           @db.Decimal(12, 2)
  netAmount      Decimal           @db.Decimal(12, 2)
  status         PaymentStatus     @default(PENDING)
  paymentMethod  PaymentMethodType @default(CREDIT_CARD)
  cardLast4      String?
  cardBrand      String?
  transactionId  String?
  idempotencyKey String?           @unique
  receiptUrl     String?
  refundReason   String?
  refundedAt     DateTime?
  refundId       String?           @unique
  refundAttempts Int               @default(0)
  refundError    String?
  attempts       PaymentAttempt[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId, createdAt])
  @@index([psychologistId, createdAt])
}

model PayoutRequest {
  id             String              @id @default(uuid())
  psychologistId String
  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  amount         Decimal             @db.Decimal(12, 2)
  idempotencyKey String?             @unique
  currency       String              @default("MXN")
  status         PayoutStatus        @default(REQUESTED)
  bankName       String
  accountClabe   String
  requestedAt    DateTime            @default(now())
  processedAt    DateTime?
  notes          String?

  @@index([psychologistId, status])
}

// No PAN, CVC or card fingerprint is persisted. A failed attempt remains auditable.
model PaymentAttempt {
  id             String        @id @default(uuid())
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey String        @unique
  provider       String        @default("MOCK")
  providerIntentId String?     @unique
  status         PaymentStatus @default(PROCESSING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// Durable simulation results. Replace the mock adapter, not this table, with a real provider.
model MockGatewayOperation {
  key       String   @id
  result    Json
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// FASE 5 — COMMUNITY (CANALES, POSTS, INTERACCIÓN Y MODERACIÓN)
// -------------------------------------------------------------

model CommunityCategory {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  channels    CommunityChannel[]

  @@index([slug])
}

model CommunityChannel {
  id              String              @id @default(uuid())
  psychologistId  String
  psychologist    PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  categoryId      String
  category        CommunityCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  description     String
  coverImageUrl   String?
  specialties     String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  posts           CommunityPost[]
  followers       ChannelFollow[]
  reports         CommunityReport[]

  @@index([psychologistId])
  @@index([categoryId])
}

model ChannelFollow {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

model CommunityPost {
  id              String            @id @default(uuid())
  channelId       String
  channel         CommunityChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId        String
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  content         String
  tags            String[]          @default([])
  status          PostStatus        @default(DRAFT)
  hiddenAt        DateTime?
  hiddenReason    String?
  hiddenById      String?
  hiddenBy        User?             @relation("PostModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  media           PostMedia[]
  likes           PostLike[]
  comments        PostComment[]
  reports         CommunityReport[]

  @@index([channelId, status])
  @@index([authorId])
  @@index([createdAt])
}

enum PostMediaType {
  IMAGE
  DOCUMENT
  LINK
}

model PostMedia {
  id           String        @id @default(uuid())
  postId       String
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  type         PostMediaType
  url          String
  thumbnailUrl String?
  caption      String?
  sizeBytes    Int?
  createdAt    DateTime      @default(now())

  @@index([postId])
}

model PostLike {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model PostComment {
  id           String            @id @default(uuid())
  postId       String
  post         CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  isHidden     Boolean           @default(false)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reports      CommunityReport[]

  @@index([postId, createdAt])
  @@index([userId])
}

enum ReportReason {
  SPAM
  HARASSMENT
  MEDICAL_MISINFORMATION
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model CommunityReport {
  id             String            @id @default(uuid())
  reporterId     String
  reporter       User              @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        CommunityChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  postId         String?
  post           CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        PostComment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String?
  status         ReportStatus      @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderatorNotes String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([reporterId, channelId])
  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
}

enum TicketSource {
  USER
  USER_REPORT
  PAYMENT
  APPOINTMENT
  SYSTEM
}

enum TicketCategory {
  ACCOUNT
  APPOINTMENT
  PAYMENT
  PSYCHOLOGIST
  TECHNICAL
  REPORT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum UserReportReason {
  UNPROFESSIONAL_CONDUCT
  HARASSMENT
  FRAUD_OR_SCAM
  IMPERSONATION
  NO_SHOW_DISPUTE
  OTHER
}

enum UserReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model SupportTicket {
  id              String          @id @default(uuid())
  ticketNumber    Int             @default(autoincrement())
  userId          String
  user            User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  source          TicketSource    @default(USER)
  category        TicketCategory
  priority        TicketPriority  @default(MEDIUM)
  status          TicketStatus    @default(OPEN)
  subject         String
  referenceType   String?         // "APPOINTMENT", "PAYMENT", "USER_REPORT"
  referenceId     String?
  firstResponseAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?
  messages        TicketMessage[]
  userReports     UserReport[]

  @@index([userId, status])
  @@index([assignedToId, status])
  @@index([status, priority])
  @@index([source])
}

model TicketMessage {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isInternalNote Boolean       @default(false)
  attachments    String[]      @default([])
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String   @unique
  ownerId   String
  scope     String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  @@index([ownerId, scope])
}

model UserReport {
  id             String           @id @default(uuid())
  reporterId     String
  reporter       User             @relation("UserReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User             @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reason         UserReportReason
  description    String
  evidenceUrls   String[]         @default([])
  status         UserReportStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?            @relation("ReportInvestigator", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderatorNotes String?
  ticketId       String?
  ticket         SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([reportedUserId])
}

// -------------------------------------------------------------
// FASE AI — ORIENTACIÓN INTELIGENTE Y TRIAJE NO DIAGNÓSTICO
// -------------------------------------------------------------

enum AIOrientationStatus {
  ACTIVE
  COMPLETED
  ESCALATED
  CANCELLED
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIRiskLevel {
  LOW
  MODERATE
  HIGH
  EMERGENCY
}

model AIOrientationSession {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation("UserAIOrientations", fields: [userId], references: [id], onDelete: Cascade)
  status          AIOrientationStatus   @default(ACTIVE)
  riskLevel       AIRiskLevel           @default(LOW)
  summary         String?               @db.Text
  needsProfile    Json?
  promptVersion   String                @default("1.0")
  provider        String                @default("MOCK")
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        AIMessage[]
  recommendations AIRecommendation[]

  @@index([userId, status])
  @@index([createdAt])
}

model AIMessage {
  id        String               @id @default(uuid())
  sessionId String
  session   AIOrientationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      AIMessageRole
  content   String               @db.Text
  createdAt DateTime             @default(now())

  @@index([sessionId, createdAt])
}

model AIRecommendation {
  id             String               @id @default(uuid())
  sessionId      String
  session        AIOrientationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  specialtyId    String
  specialty      Specialty            @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  psychologistId String?
  psychologist   PsychologistProfile? @relation(fields: [psychologistId], references: [id], onDelete: SetNull)
  reason         String               @db.Text
  score          Float?
  createdAt      DateTime             @default(now())

  @@index([sessionId])
  @@index([psychologistId])
  @@index([specialtyId])
}

model AICrisisResource {
  id          String   @id @default(uuid())
  countryCode String   @default("MX")
  name        String
  phone       String
  url         String?
  description String?
  type        String   @default("GENERAL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryCode, isActive])
}
