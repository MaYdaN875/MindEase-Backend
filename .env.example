PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindease?schema=public"
JWT_SECRET="super-secret-mindease-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV=development
SEED_TEST_USER=false
TEST_USER_EMAIL="paciente@test.mindease.local"
TEST_USER_PASSWORD="change-this-local-test-password"
AI_RATE_LIMIT_PER_MINUTE=15
INITIAL_INTERVIEW_ALLOW_DEV_REPORT=false
JAAS_ENABLED=false
JAAS_APP_ID=""
JAAS_KEY_ID=""
# Store PEM privately in Railway; real newlines or escaped \n are supported.
JAAS_PRIVATE_KEY=""
# Only set true AFTER disabling unauthenticated participants in the JaaS console.
JAAS_AUTH_REQUIRED_CONFIRMED=false

# Email (Resend). EMAIL_PROVIDER=console only logs a notice, never the code.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=MindEase <no-reply@example.com>

# Persistent storage (mount a Railway Volume and point these to it, e.g. /data/...)
PRIVATE_DOCUMENTS_ROOT=
MEDIA_STORAGE_ROOT=

# Firebase Cloud Messaging (push notifications). Keep false until credentials are configured.
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON (raw JSON or base64) OR the 3 separate fields.
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Entrevista inicial clínica: habilitar solo después de aprobar privacidad y tratamiento de datos.
# Reuses GEMINI_API_KEY and GEMINI_MODEL from AI orientation.
INITIAL_INTERVIEW_GEMINI_DATA_POLICY_CONFIRMED=false
# 32 bytes aleatorios, codificados en base64. Mantener fuera del repositorio y respaldar de forma segura.
INITIAL_INTERVIEW_ENCRYPTION_KEY=
INITIAL_INTERVIEW_AI_TIMEOUT_MS=30000
