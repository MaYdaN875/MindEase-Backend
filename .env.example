PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindease?schema=public"
JWT_SECRET="super-secret-mindease-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JAAS_ENABLED=false
JAAS_APP_ID=""
JAAS_KEY_ID=""
# Store PEM privately in Railway; real newlines or escaped \n are supported.
JAAS_PRIVATE_KEY=""
# Only set true AFTER disabling unauthenticated participants in the JaaS console.
JAAS_AUTH_REQUIRED_CONFIRMED=false
